# SMTP 邮件服务（用于发送注册验证码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@qq.com
SMTP_PASS=your-smtp-authorization-code
# 发件地址须与 SMTP_USER 是同一个账号；不一致时服务会自动改用 SMTP_USER 发件。
SMTP_FROM=时语 TimeWhisper <your-account@qq.com>
# 猫猫管理员专用发件人；未配置时回退 SMTP_FROM
CATKEEPER_SMTP_FROM=猫猫管理员 MeowKeeper <your-account@qq.com>

# 生产环境请改为足够长的随机字符串
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_CODE_SECRET=replace-with-another-long-random-secret

# 额外允许跨域访问认证接口的前端来源，逗号分隔
# TIMEWHISPER_ALLOWED_ORIGINS=https://your-frontend.example.com
